{
    "name": "chromavim",
    "displayName": "Chromavim",
    "description": "Changes the color of Razer Chroma based on VsCodeVim mode",
    "version": "0.0.1",
    "publisher": "Viker",
    "engines": {
        "vscode": "^1.20.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.vschroma.startAnimation",
                "title": "Start Chroma Animation"
            },
            {
                "command": "extension.vschroma.stopAnimation",
                "title": "Stop Chroma Animation"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node ./node_modules/@vscode/test-electron/out/runTest.js"
    },
    "devDependencies": {
        "@types/mocha": "^9.1.0",
        "@types/node": "^16.0.0",
        "@types/sinon": "^10.0.0",
        "@types/vscode": "^1.20.0",
        "@vscode/test-electron": "^2.3.8",
        "sinon": "^15.0.0",
        "tslint": "^5.8.0",
        "typescript": "^4.9.0"
    },
    "dependencies": {
        "node-fetch": "^2.0.0",
        "@pastez/chromajs": "git+https://github.com/Pastez/chroma-js.git"
    }
}
