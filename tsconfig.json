{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "outDir": "out",
        "lib": [
            "es2019",
            "DOM"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "noUnusedLocals": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "typeRoots": [
            "./node_modules/@types",
            "./node_modules/vscode/vscode.d.ts"
        ],
        "skipLibCheck": true
    },
    "exclude": [
        "node_modules",
        ".vscode-test",
        "src/test"
    ]
}
